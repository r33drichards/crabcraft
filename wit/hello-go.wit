// crabcraft hello-world interface, Go (TinyGo) edition. Same shape as
// crab:hello but its own package id so both can be deployed side by side.
package crab:hello-go@0.1.0;

interface greeter {
  record greet-request {
    name: string,
    /// optional flourish; older clients simply omit it (option = back-compat)
    excited: option<bool>,
  }

  greet: func(req: greet-request) -> string;
  add: func(a: u32, b: u32) -> u32;
}

world hello-go {
  export greeter;
}
