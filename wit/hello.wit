// crabcraft hello-world interface. Versioned package: backwards-compatible
// evolution = add functions freely; new inputs as option<T>; breaking changes
// bump the version and the daemon serves both side by side.
package crab:hello@0.1.0;

interface greeter {
  record greet-request {
    name: string,
    /// optional flourish; older clients simply omit it (option = back-compat)
    excited: option<bool>,
  }

  greet: func(req: greet-request) -> string;
  add: func(a: u32, b: u32) -> u32;
}

world hello {
  export greeter;
}
